{
  "mcpServers": {
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "--from",
        "code-review-graph[embeddings]",
        "code-review-graph",
        "serve"
      ],
      "type": "stdio"
    },
    "heroui-react": {
      "command": "npx",
      "args": ["-y", "@heroui/react-mcp@latest"],
      "type": "stdio"
    }
  }
}
