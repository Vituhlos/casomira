<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Oprávnění pro hardened runtime na macOS. Bez nich appka s nativním modulem
    (better-sqlite3) spadne hned po startu (EXC_BREAKPOINT / SIGTRAP), protože
    macOS odmítne načíst .node knihovnu podepsanou jinak než zbytek aplikace.

    Klíčové je `disable-library-validation` — povolí načíst nativní modul, který
    není podepsaný stejným Apple Team ID (u ad-hoc / nepodepsaného test buildu).
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- V8/JIT v Electronu potřebuje spustitelnou paměť. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Electron při startu čte DYLD_* proměnné prostředí. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
