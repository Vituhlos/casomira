{
  "name": "verdict",
  "version": "0.9.13-beta",
  "description": "Verdict — správce závodu autokros / rallycross",
  "author": "Verdict",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vituhlos/casomira.git"
  },
  "homepage": "https://github.com/Vituhlos/casomira#readme",
  "bugs": {
    "url": "https://github.com/Vituhlos/casomira/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "npm run build:metadata",
    "dev": "electron-vite dev",
    "build:metadata": "node scripts/generate-build-info.mjs",
    "prebuild": "npm run build:metadata",
    "build": "electron-vite build",
    "pretypecheck": "npm run build:metadata",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:release": "node scripts/check-release.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml --publish never",
    "dist:win:dir": "npm run build && electron-builder --win dir --config electron-builder.yml --publish never",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml --publish never -c.npmRebuild=true",
    "dist:mac:dir": "npm run build && electron-builder --mac dir --config electron-builder.yml --publish never -c.npmRebuild=true",
    "docs:word": "npx --yes @mohtasham/md-to-docx docs/user/INSTALACE-MAC.md docs/user/Verdict-instalace-Mac.docx && npx --yes @mohtasham/md-to-docx docs/user/NAVOD-PRO-TESTERY.md docs/user/Verdict-navod-pro-testery.docx"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@gravity-ui/icons": "^2.18.0",
    "@heroui/react": "3.2.1",
    "@heroui/styles": "3.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "4.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.8"
  }
}
