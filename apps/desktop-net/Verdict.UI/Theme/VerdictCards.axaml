<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         Verdict.UI — karta závodu (race hub), chování dle Electronu:
         hover = nadzvednutí + větší stín + fade-in akčních ikon vpravo nahoře.
         ════════════════════════════════════════════════════════════════ -->

    <!-- Karta závodu -->
    <Style Selector="Border.race-card">
        <Setter Property="Background" Value="{DynamicResource VerdictSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource VerdictBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Width" Value="248"/>
        <Setter Property="MinHeight" Value="176"/>
        <Setter Property="BoxShadow" Value="0 2 5 -1 #1C000000, 0 8 20 -4 #18000000"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.race-card:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-4px)"/>
        <Setter Property="BoxShadow" Value="0 6 14 -3 #26000000, 0 18 36 -8 #22000000"/>
    </Style>

    <!-- Akční ikony (zálohovat / upravit / smazat) — skryté, fade-in na hover -->
    <Style Selector="StackPanel.card-actions">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.race-card:pointerover StackPanel.card-actions">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Ikonové tlačítko v kartě -->
    <Style Selector="Button.card-icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Foreground" Value="{DynamicResource VerdictMutedBrush}"/>
    </Style>
    <Style Selector="Button.card-icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource VerdictGhostHoverBrush}"/>
    </Style>
    <Style Selector="Button.card-icon.danger:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource VerdictDqBrush}"/>
    </Style>

    <!-- Typ-chip uvnitř karty (RAC RACE) — soft teal -->
    <Style Selector="Border.race-chip">
        <Setter Property="Background" Value="{DynamicResource VerdictTealSoftBrush}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Border.race-chip > TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.5"/>
        <Setter Property="Foreground" Value="{DynamicResource VerdictTealBrush}"/>
    </Style>

    <!-- Texty karty -->
    <Style Selector="TextBlock.race-card-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource VerdictForegroundBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.race-card-meta">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}"/>
        <Setter Property="Foreground" Value="{DynamicResource VerdictSecondaryBrush}"/>
    </Style>

    <!-- Přidávací karta — dashed obrys (Border nemá dash → Rectangle) -->
    <Style Selector="Rectangle.race-add-outline">
        <Setter Property="Stroke" Value="{DynamicResource VerdictBorderBrush}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeDashArray" Value="5,3"/>
        <Setter Property="RadiusX" Value="16"/>
        <Setter Property="RadiusY" Value="16"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

</Styles>
