<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Semantické štětce odvozené z Verdict tokenů (Color → Brush).
         Color se resolvuje přes DynamicResource → automaticky se mění s light/dark.
         Tohle je JEDINÝ způsob, jak v obrazovkách sahat na barvy — žádné raw hex. -->

    <SolidColorBrush x:Key="VerdictForegroundBrush" Color="{DynamicResource ForegroundColor}"/>
    <SolidColorBrush x:Key="VerdictSecondaryBrush" Color="{DynamicResource SecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="VerdictMutedBrush" Color="{DynamicResource MutedColor}"/>

    <SolidColorBrush x:Key="VerdictSidebarBrush" Color="{DynamicResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="VerdictTabBarBrush" Color="{DynamicResource TabBarColor}"/>
    <SolidColorBrush x:Key="VerdictSelectionBrush" Color="{DynamicResource SelectionColor}"/>
    <SolidColorBrush x:Key="VerdictGhostHoverBrush" Color="{DynamicResource GhostHoverColor}"/>

    <SolidColorBrush x:Key="VerdictBorderBrush" Color="{DynamicResource BorderColor}"/>

    <SolidColorBrush x:Key="VerdictPrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="VerdictPrimaryForegroundBrush" Color="{DynamicResource PrimaryForegroundColor}"/>
    <SolidColorBrush x:Key="VerdictAccentBrush" Color="{DynamicResource AccentColor}"/>

    <!-- Pill pozadí (počty kategorií, jemné chipy) -->
    <SolidColorBrush x:Key="VerdictBadgeBrush" Color="{DynamicResource ForegroundColor}" Opacity="0.08"/>

    <!-- Stavy jízdy: text + soft pozadí -->
    <SolidColorBrush x:Key="VerdictDnfBrush" Color="{DynamicResource DnfColor}"/>
    <SolidColorBrush x:Key="VerdictDnsBrush" Color="{DynamicResource DnsColor}"/>
    <SolidColorBrush x:Key="VerdictDqBrush" Color="{DynamicResource DqColor}"/>
    <SolidColorBrush x:Key="VerdictDnfSoftBrush" Color="{DynamicResource DnfColor}" Opacity="0.18"/>
    <SolidColorBrush x:Key="VerdictDnsSoftBrush" Color="{DynamicResource DnsColor}" Opacity="0.22"/>
    <SolidColorBrush x:Key="VerdictDqSoftBrush" Color="{DynamicResource DqColor}" Opacity="0.18"/>

    <!-- Typ závodu (chip RAC RACE) — teal -->
    <SolidColorBrush x:Key="VerdictTealBrush" Color="{DynamicResource TealColor}"/>
    <SolidColorBrush x:Key="VerdictTealSoftBrush" Color="{DynamicResource TealColor}" Opacity="0.16"/>

</ResourceDictionary>
