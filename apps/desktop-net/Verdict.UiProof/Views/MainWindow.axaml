<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Verdict.UiProof.Views"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="Verdict.UiProof.Views.MainWindow"
        x:DataType="views:MainWindow"
        Title="Verdict — N1600 · Startovní listina"
        Width="1280" Height="780"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Verdict.UI/Assets/verdict.ico"
        Background="{DynamicResource VerdictHostFallbackBrush}">

    <SplitView x:Name="Split" Margin="12"
               DisplayMode="Inline" IsPaneOpen="True"
               OpenPaneLength="264" CompactPaneLength="0"
               PaneBackground="Transparent">

        <!-- ══ SIDEBAR ══════════════════════════════════════════════ -->
        <SplitView.Pane>
        <Border Background="{DynamicResource VerdictSidebarBrush}"
                Margin="0,0,12,0"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{DynamicResource VerdictBorderBrush}">
            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Spacing="6" Margin="14,16,14,10">
                    <Image Width="150" Height="34"
                           Stretch="Uniform"
                           HorizontalAlignment="Left">
                        <Image.Source>
                            <svg:SvgImage Source="avares://Verdict.UI/Assets/verdict-mainlogo-dark.svg"/>
                        </Image.Source>
                    </Image>
                    <Button Classes="ghost"
                            HorizontalAlignment="Left"
                            Padding="8,5"
                            Margin="0,6,0,0"
                            Content="←  Závody"/>
                </StackPanel>

                <DockPanel Grid.Row="1">
                    <TextBlock DockPanel.Dock="Top"
                               Text="KATEGORIE" Classes="label"
                               Margin="16,4,12,6"/>
                    <ScrollViewer>
                        <ListBox Classes="sidebar"
                                 ItemsSource="{Binding Kategorie}"
                                 SelectedIndex="2">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="views:Kategorie">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Nazev}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource VerdictBadgeBrush}"
                                                CornerRadius="10"
                                                Padding="7,1"
                                                MinWidth="24">
                                            <TextBlock Text="{Binding Pocet}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource VerdictMutedBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource VerdictBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Časoměřič"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource VerdictForegroundBrush}"/>
                        <TextBlock Text="30. 5. 2026"
                                   FontSize="11"
                                   Foreground="{DynamicResource VerdictMutedBrush}"/>
                        <TextBlock Text="Verdict v0.9.13-beta"
                                   FontSize="10.5"
                                   Opacity="0.55"
                                   Foreground="{DynamicResource VerdictMutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        </SplitView.Pane>

        <!-- ══ HLAVNÍ OBLAST ════════════════════════════════════════ -->
        <Grid RowDefinitions="Auto,12,*">

            <!-- TOPBAR -->
            <Border Grid.Row="0"
                    Background="{DynamicResource VerdictSidebarBrush}"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource VerdictBorderBrush}"
                    Padding="14,12">
                <Grid RowDefinitions="Auto,10,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="PaneToggle" Grid.Column="0"
                                Classes="ghost" Content="☰" Padding="9,5"
                                Margin="0,0,8,0"
                                IsVisible="False"
                                ToolTip.Tip="Kategorie"
                                Click="OnTogglePane"/>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center">
                            <Run Text="N1600" Foreground="{DynamicResource VerdictForegroundBrush}" FontWeight="SemiBold"/>
                            <Run Text="  ›  Startovní listina" Foreground="{DynamicResource VerdictSecondaryBrush}"/>
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Classes="ghost" Content="☽" Padding="9,5"/>
                            <Button Classes="ghost" Content="⚙" Padding="9,5"/>
                            <Button Classes="outline" Content="Stopky"/>
                            <Button Classes="ghost" Content="Tisknout"/>
                            <Button Classes="primary" Content="Uložit PDF  ▾"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="{DynamicResource VerdictTabBarBrush}"
                            CornerRadius="11"
                            Padding="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ListBox Classes="tabs" SelectedIndex="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBoxItem Content="Startovní listina"/>
                                <ListBoxItem Content="Q1"/>
                                <ListBoxItem Content="Q2"/>
                                <ListBoxItem Content="Klasifikace po Q2"/>
                                <ListBoxItem Content="Q3"/>
                                <ListBoxItem Content="Klasifikace po Q3"/>
                                <ListBoxItem Content="Semifinále"/>
                                <ListBoxItem Content="Finále"/>
                                <ListBoxItem Content="Celkově"/>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- CONTENT SURFACE -->
            <Border Grid.Row="2"
                    Background="{DynamicResource VerdictSurfaceBrush}"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource VerdictBorderBrush}"
                    ClipToBounds="True">
                <DockPanel Margin="0">
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="22,20,22,14">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="Startovní listina" Classes="h1"/>
                            <TextBlock Text="19 přihlášených · 4 čeká na přejímku · řazeno dle losu"
                                       Classes="subtitle"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Classes="outline" Content="Importovat z Excelu"/>
                            <Button Classes="primary" Content="＋ Přidat jezdce"/>
                        </StackPanel>
                    </Grid>

                    <!-- Table header -->
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="70,84,*,150,150,180"
                          Margin="22,0,22,0"
                          Height="34">
                        <TextBlock Grid.Column="0" Text="LOS" Classes="th"/>
                        <TextBlock Grid.Column="1" Text="ST. Č." Classes="th"/>
                        <TextBlock Grid.Column="2" Text="PŘÍJMENÍ" Classes="th"/>
                        <TextBlock Grid.Column="3" Text="JMÉNO" Classes="th"/>
                        <TextBlock Grid.Column="4" Text="ZNAČKA" Classes="th"/>
                        <TextBlock Grid.Column="5" Text="MODEL" Classes="th"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1"
                            Background="{DynamicResource VerdictBorderBrush}"
                            Margin="22,0"/>

                    <!-- Rows -->
                    <ListBox Classes="verdict-table"
                             ItemsSource="{Binding Jezdci}"
                             Margin="10,0,10,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="views:Rider">
                                <Grid ColumnDefinitions="70,84,*,150,150,180">
                                    <TextBlock Grid.Column="0" Text="{Binding Los}" Classes="td-num"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Cislo}" Classes="td-strong"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Prijmeni}" Classes="td-strong"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Jmeno}" Classes="td"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Znacka}" Classes="td"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Model}" Classes="td"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </SplitView>
</Window>
