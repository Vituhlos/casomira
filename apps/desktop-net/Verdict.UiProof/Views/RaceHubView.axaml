<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Verdict.UiProof.Views.RaceHubView">

    <Grid Margin="12" RowDefinitions="Auto,12,*">

        <!-- ══ TOPBAR ════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource VerdictSidebarBrush}"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{DynamicResource VerdictBorderBrush}"
                Padding="20,10">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Image Grid.Column="0"
                       Source="avares://Verdict.UI/Assets/verdict-mainlogo-light.png"
                       Height="34" Stretch="Uniform"
                       HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="outline" Content="⤴  Obnovit…"/>
                    <Button Classes="ghost" Content="☽" Padding="9,5"/>
                    <Button Classes="primary" Content="⚑  Nový závod"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ OBSAH ═════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource VerdictSurfaceBrush}"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{DynamicResource VerdictBorderBrush}"
                ClipToBounds="True">
            <StackPanel Margin="40,32,40,40" Spacing="28">

                <StackPanel Spacing="4">
                    <TextBlock Text="Správa závodů"
                               FontSize="{DynamicResource FontSize3xl}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource VerdictForegroundBrush}"/>
                    <TextBlock Text="autokros · rallycross" Classes="subtitle"/>
                </StackPanel>

                <!-- Karty závodů -->
                <StackPanel Orientation="Horizontal" Spacing="16">

                    <!-- Existující závod -->
                    <Border Classes="race-card">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                            <Border Grid.Row="0" Classes="race-chip">
                                <TextBlock Text="RAC RACE"/>
                            </Border>
                            <TextBlock Grid.Row="1" Classes="race-card-title"
                                       Text="MČR Autocross — Přerov"
                                       Margin="0,14,0,0"/>
                            <TextBlock Grid.Row="2" Classes="race-card-meta"
                                       Text="30. 5. 2026 · Přerov"
                                       Margin="0,6,0,0"/>
                            <Border Grid.Row="4" Height="1"
                                    Background="{DynamicResource VerdictBorderBrush}"
                                    Margin="0,12,0,0"/>
                            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="▦" Classes="race-card-meta"/>
                                    <TextBlock Text="11 kategorií" Classes="race-card-meta"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="◍" Classes="race-card-meta"/>
                                    <TextBlock Text="124 jezdců" Classes="race-card-meta"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Přidat závod -->
                    <Panel Width="248" MinHeight="176">
                        <Rectangle Classes="race-add-outline"/>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="{DynamicResource FontSizeLg}"
                                       Foreground="{DynamicResource VerdictMutedBrush}"/>
                            <TextBlock Text="Nový závod" Classes="race-card-meta"/>
                        </StackPanel>
                    </Panel>

                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
