<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
             x:Class="Verdict.UiProof.Views.RaceHubView">

    <Grid Margin="12" RowDefinitions="Auto,12,*">

        <!-- ══ TOPBAR ════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource VerdictSidebarBrush}"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{DynamicResource VerdictBorderBrush}"
                Padding="20,10">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Image Grid.Column="0"
                       Height="34" Stretch="Uniform"
                       HorizontalAlignment="Left">
                    <Image.Source>
                        <svg:SvgImage Source="avares://Verdict.UI/Assets/verdict-mainlogo-light.svg"/>
                    </Image.Source>
                </Image>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="outline">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="Upload" Size="16"/>
                            <TextBlock Text="Obnovit…"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Padding="8,5">
                        <lucide:LucideIcon Kind="Moon" Size="17"/>
                    </Button>
                    <Button Classes="primary">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <lucide:LucideIcon Kind="Flag" Size="16"/>
                            <TextBlock Text="Nový závod"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ OBSAH ═════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource VerdictSurfaceBrush}"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{DynamicResource VerdictBorderBrush}"
                ClipToBounds="True">
            <StackPanel Margin="40,32,40,40" Spacing="28">

                <StackPanel Spacing="4">
                    <TextBlock Text="Správa závodů"
                               FontSize="{DynamicResource FontSize3xl}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource VerdictForegroundBrush}"/>
                    <TextBlock Text="autokros · rallycross" Classes="subtitle"/>
                </StackPanel>

                <!-- Karty závodů -->
                <StackPanel Orientation="Horizontal" Spacing="16">

                    <!-- Existující závod -->
                    <Border Classes="race-card">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

                            <!-- Hlavička: chip vlevo + akce vpravo (hover) -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Border Grid.Column="0" Classes="race-chip rac">
                                    <TextBlock Text="RAC RACE"/>
                                </Border>
                                <StackPanel Grid.Column="1" Classes="card-actions"
                                            Orientation="Horizontal" Spacing="2"
                                            Margin="0,-4,-6,0">
                                    <Button Classes="card-icon" ToolTip.Tip="Zálohovat závod">
                                        <lucide:LucideIcon Kind="Download" Size="15"/>
                                    </Button>
                                    <Button Classes="card-icon" ToolTip.Tip="Upravit údaje">
                                        <lucide:LucideIcon Kind="Pencil" Size="15"/>
                                    </Button>
                                    <Button Classes="card-icon danger" ToolTip.Tip="Smazat závod">
                                        <lucide:LucideIcon Kind="Trash2" Size="15"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1" Classes="race-card-title"
                                       Text="MČR Autocross — Přerov"
                                       Margin="0,14,0,0"/>
                            <TextBlock Grid.Row="2" Classes="race-card-meta"
                                       Text="30. 5. 2026 · Přerov"
                                       Margin="0,6,0,0"/>
                            <Border Grid.Row="4" Height="1"
                                    Background="{DynamicResource VerdictBorderBrush}"
                                    Margin="0,12,0,0"/>
                            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <lucide:LucideIcon Kind="LayoutGrid" Size="13"
                                                       Foreground="{DynamicResource VerdictSecondaryBrush}"/>
                                    <TextBlock Text="11 kategorií" Classes="race-card-meta"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <lucide:LucideIcon Kind="Users" Size="13"
                                                       Foreground="{DynamicResource VerdictSecondaryBrush}"/>
                                    <TextBlock Text="124 jezdců" Classes="race-card-meta"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RX Cup závod (jiný typ → jiná barva) -->
                    <Border Classes="race-card">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Border Classes="race-chip rx"><TextBlock Text="RX CUP"/></Border>
                                    <Border Classes="race-chip warn"><TextBlock Text="Ve vývoji"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="card-actions"
                                            Orientation="Horizontal" Spacing="2" Margin="0,-4,-6,0">
                                    <Button Classes="card-icon" ToolTip.Tip="Zálohovat závod">
                                        <lucide:LucideIcon Kind="Download" Size="15"/>
                                    </Button>
                                    <Button Classes="card-icon" ToolTip.Tip="Upravit údaje">
                                        <lucide:LucideIcon Kind="Pencil" Size="15"/>
                                    </Button>
                                    <Button Classes="card-icon danger" ToolTip.Tip="Smazat závod">
                                        <lucide:LucideIcon Kind="Trash2" Size="15"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Classes="race-card-title"
                                       Text="RX Cup — Sosnová" Margin="0,14,0,0"/>
                            <TextBlock Grid.Row="2" Classes="race-card-meta"
                                       Text="14. 6. 2026 · Sosnová" Margin="0,6,0,0"/>
                            <Border Grid.Row="4" Height="1"
                                    Background="{DynamicResource VerdictBorderBrush}" Margin="0,12,0,0"/>
                            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <lucide:LucideIcon Kind="LayoutGrid" Size="13"
                                                       Foreground="{DynamicResource VerdictSecondaryBrush}"/>
                                    <TextBlock Text="9 kategorií" Classes="race-card-meta"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <lucide:LucideIcon Kind="Users" Size="13"
                                                       Foreground="{DynamicResource VerdictSecondaryBrush}"/>
                                    <TextBlock Text="86 jezdců" Classes="race-card-meta"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Přidat závod -->
                    <Panel Width="248" MinHeight="176">
                        <Rectangle Classes="race-add-outline"/>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <lucide:LucideIcon Kind="Plus" Size="16"
                                               Foreground="{DynamicResource VerdictMutedBrush}"/>
                            <TextBlock Text="Nový závod" Classes="race-card-meta"/>
                        </StackPanel>
                    </Panel>

                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
