<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Verdict.UiProof.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Verdict.UI/Theme/VerdictTypography.axaml" />
        <StyleInclude Source="avares://Verdict.UI/Theme/VerdictControls.axaml" />
        <StyleInclude Source="avares://Verdict.UI/Theme/VerdictTable.axaml" />
        <StyleInclude Source="avares://Verdict.UI/Theme/VerdictBadges.axaml" />
        <StyleInclude Source="avares://Verdict.UI/Theme/VerdictCards.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Verdict.UI/Tokens/VerdictTokens.axaml" />
                <ResourceInclude Source="avares://Verdict.UI/Theme/VerdictBrushes.axaml" />
                <ResourceInclude Source="avares://Verdict.UI/Theme/VerdictIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
