<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shad="using:ShadUI"
             x:Class="Verdict.Desktop.App"
             xmlns:local="using:Verdict.Desktop"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <shad:ShadTheme />
    </Application.Styles>

    <!-- Token overrides — barvy z CLAUDE.md §2c -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <!-- Accent -->
                    <Color x:Key="AccentColor">#007AFF</Color>
                    <!-- Backgrounds -->
                    <Color x:Key="BackgroundColor">#F7F7F9</Color>
                    <Color x:Key="SurfaceColor">#FFFFFF</Color>
                    <Color x:Key="SidebarColor">#F8F8FA</Color>
                    <!-- Text -->
                    <Color x:Key="ForegroundColor">#1D1D1F</Color>
                    <Color x:Key="SecondaryForegroundColor">#8E8E93</Color>
                    <!-- Dividers -->
                    <Color x:Key="BorderColor">#E5E5EA</Color>
                    <!-- Status badges -->
                    <Color x:Key="DnfColor">#FF9500</Color>
                    <Color x:Key="DnsColor">#8E8E93</Color>
                    <Color x:Key="DqColor">#FF3B30</Color>
                    <!-- Medals -->
                    <Color x:Key="MedalGoldColor">#FFD700</Color>
                    <Color x:Key="MedalSilverColor">#C0C0C0</Color>
                    <Color x:Key="MedalBronzeColor">#CD7F32</Color>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!-- Accent -->
                    <Color x:Key="AccentColor">#0A84FF</Color>
                    <!-- Backgrounds -->
                    <Color x:Key="BackgroundColor">#313133</Color>
                    <Color x:Key="SurfaceColor">#2C2C2E</Color>
                    <Color x:Key="SidebarColor">#242425</Color>
                    <!-- Text -->
                    <Color x:Key="ForegroundColor">#F5F5F7</Color>
                    <Color x:Key="SecondaryForegroundColor">#98989D</Color>
                    <!-- Dividers -->
                    <Color x:Key="BorderColor">#3A3A3C</Color>
                    <!-- Status badges -->
                    <Color x:Key="DnfColor">#FF9F0A</Color>
                    <Color x:Key="DnsColor">#98989D</Color>
                    <Color x:Key="DqColor">#FF453A</Color>
                    <!-- Medals -->
                    <Color x:Key="MedalGoldColor">#FFD700</Color>
                    <Color x:Key="MedalSilverColor">#C0C0C0</Color>
                    <Color x:Key="MedalBronzeColor">#CD7F32</Color>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
