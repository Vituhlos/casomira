<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Verdict.Desktop.ViewModels"
             x:Class="Verdict.Desktop.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
        <TextBlock Text="{Binding Message}"
                   FontSize="16"
                   Foreground="{DynamicResource SecondaryForegroundColor}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="(Phase 3 — obrazovky budou implementovány)"
                   FontSize="12"
                   Foreground="{DynamicResource SecondaryForegroundColor}"
                   HorizontalAlignment="Center"
                   Opacity="0.6"/>
    </StackPanel>

</UserControl>
