<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Verdict.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        xmlns:model="using:Verdict.Core.Model"
        x:Class="Verdict.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Verdict"
        MinWidth="900" MinHeight="600"
        Width="1200" Height="750">

    <Window.Styles>
        <!-- Phase tab bar: přizpůsobení ListBoxItem tak aby vypadal jako segmentový přepínač -->
        <Style Selector="ListBox.phaseTabs ListBoxItem">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundColor}"/>
        </Style>
        <Style Selector="ListBox.phaseTabs ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ListBox.phaseTabs ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        </Style>
        <Style Selector="ListBox.phaseTabs ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Sidebar: ListBox bez výchozího rámečku a paddingu -->
        <Style Selector="ListBox.sidebar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.sidebar ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.sidebar ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ListBox.sidebar ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style Selector="ListBox.sidebar ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        </Style>
    </Window.Styles>

    <!-- Root: sidebar vlevo + hlavní oblast vpravo -->
    <Grid ColumnDefinitions="240,*">

        <!-- ══ SIDEBAR ══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Výběr / založení závodu -->
                <StackPanel Grid.Row="0"
                            Spacing="6"
                            Margin="12,12,12,8">
                    <TextBlock Text="ZÁVOD"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundColor}"/>
                    <ComboBox ItemsSource="{Binding Zavody}"
                              SelectedItem="{Binding CurrentZavod}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="(žádný závod)"
                              FontSize="13">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model:ZavodInfo">
                                <TextBlock Text="{Binding Nazev}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="NovyZavodButton"
                            Content="＋ Nový závod"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="13"
                            Click="OnNovyZavod"
                            Classes="outline"/>
                </StackPanel>

                <!-- Seznam kategorií -->
                <DockPanel Grid.Row="1">

                    <TextBlock DockPanel.Dock="Top"
                               Text="KATEGORIE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundColor}"
                               Margin="12,12,12,4"/>

                    <!-- Prázdný stav -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="(žádný závod)"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryForegroundColor}"
                               Margin="12,4"
                               IsVisible="{Binding !Kategorie.Count}"/>

                    <ScrollViewer>
                        <ListBox Classes="sidebar"
                                 ItemsSource="{Binding Kategorie}"
                                 SelectedItem="{Binding SelectedKategorie}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:KategorieRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Nazev}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PocetText}"
                                                   FontSize="11"
                                                   Opacity="0.7"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>

                <!-- Operátor + závod dole -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,1,0,0"
                        Padding="12,10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding CurrentZavod.Nazev, FallbackValue='— závod nevybrán —'}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentZavod.Datum, FallbackValue=''}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundColor}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ HLAVNÍ OBLAST ═════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

            <!-- TOOLBAR -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid ColumnDefinitions="*,Auto">

                    <!-- Breadcrumb vlevo -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Breadcrumb}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryForegroundColor}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Tlačítka vpravo -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6">
                        <Button Content="🌓"
                                ToolTip.Tip="Přepnout světlý/tmavý motiv"
                                Command="{Binding PrepnoutTemaCommand}"
                                FontSize="14"
                                Padding="8,4"
                                Classes="outline"/>
                        <Button Content="Stopky"
                                Command="{Binding OtevritStopkyCommand}"
                                FontSize="13"
                                Classes="outline"/>
                        <Button Content="Uložit PDF"
                                Command="{Binding UlozitPdfCommand}"
                                FontSize="13"
                                Classes="primary"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SEGMENTOVÝ PŘEPÍNAČ FÁZ
                 Vodorovný scroll — žádné ořezávání (viz CLAUDE.md §2c). -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6"
                    IsVisible="{Binding FazeTabs.Count}">
                <ListBox Classes="phaseTabs"
                         ItemsSource="{Binding FazeTabs}"
                         SelectedItem="{Binding SelectedFaze}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FazeTabViewModel">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- OBSAH — ViewLocator překládá CurrentContent VM na správnou View -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BackgroundColor}">
                <ContentControl Content="{Binding CurrentContent}"/>
            </Border>
        </Grid>
    </Grid>

</Window>
