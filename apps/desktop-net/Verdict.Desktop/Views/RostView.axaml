<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Verdict.Desktop.ViewModels"
             x:Class="Verdict.Desktop.Views.RostView"
             x:DataType="vm:RostViewModel">

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Padding="12,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderColor}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="＋ Přidat jízdu"
                        Command="{Binding PridatJizduCommand}"
                        Classes="outline"/>
                <Button Content="Smazat jízdu"
                        Command="{Binding SmazatJizduCommand}"
                        CommandParameter="{Binding SelectedJizda}"
                        IsEnabled="{Binding SelectedJizda, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Classes="outline"/>
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Opacity="0.75"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- Jizdy -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="JizdyList"
                          ItemsSource="{Binding Jizdy}"
                          Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RostJizdaViewModel">
                        <StackPanel Margin="0,0,0,16">

                            <TextBlock Text="{Binding CisloLabel}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="12,6,12,4"/>

                            <DataGrid ItemsSource="{Binding Sloty}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      GridLinesVisibility="Horizontal"
                                      CanUserResizeColumns="True"
                                      CellEditEnded="OnSlotCellEditEnded">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Poz."     Binding="{Binding Pozice}"     Width="55"  IsReadOnly="True"/>
                                    <DataGridTextColumn Header="St.č."    Binding="{Binding StCisloText}" Width="70"/>
                                    <DataGridTextColumn Header="Příjmení" Binding="{Binding Prijmeni}"   Width="170" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Jméno"    Binding="{Binding Jmeno}"      Width="130" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Značka"   Binding="{Binding Znacka}"     Width="130" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Model"    Binding="{Binding Model}"      Width="150" IsReadOnly="True"/>
                                </DataGrid.Columns>

                            </DataGrid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
