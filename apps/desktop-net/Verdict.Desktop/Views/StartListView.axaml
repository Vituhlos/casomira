<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Verdict.Desktop.ViewModels"
             x:Class="Verdict.Desktop.Views.StartListView"
             x:DataType="vm:StartListViewModel">

    <DockPanel Background="{DynamicResource SurfaceColor}">

        <!-- Záhlaví sekce s názvem, podtitulem a akčními tlačítky -->
        <Border DockPanel.Dock="Top"
                Padding="20,18,20,10"
                BorderThickness="0"
                Background="{DynamicResource SurfaceColor}">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Název + status podtitulek vlevo -->
                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                     <TextBlock Text="Startovní listina"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundColor}"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundColor}"
                               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Tlačítka vpravo -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ImportButton"
                            Content="Importovat z Excelu"
                            Classes="outline"
                            Click="OnImportClick"/>
                    <Button Content="＋ Přidat jezdce"
                            Command="{Binding PridatJezdceCommand}"
                            Classes="primary"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabulka jezdců -->
        <Border Classes="verdict-table-sheet"
                Margin="20,8,20,20">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Jezdci}"
                      SelectedItem="{Binding SelectedJezdec}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource SurfaceColor}"
                      CellEditEnded="OnCellEditEnded">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Los"      Binding="{Binding LosText}"      Width="70"/>
                <DataGridTextColumn Header="St.č."    Binding="{Binding StCisloText}"  Width="80"/>
                <DataGridTemplateColumn Header="Příjmení" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:JezdecRowViewModel">
                            <TextBlock Text="{Binding Prijmeni}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate x:DataType="vm:JezdecRowViewModel">
                            <TextBox Text="{Binding Prijmeni}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Jméno"    Binding="{Binding Jmeno}"        Width="140"/>
                <DataGridTextColumn Header="Značka"   Binding="{Binding Znacka}"       Width="135"/>
                <DataGridTextColumn Header="Model"    Binding="{Binding Model}"        Width="175"/>
            </DataGrid.Columns>

            </DataGrid>
        </Border>

    </DockPanel>

</UserControl>
