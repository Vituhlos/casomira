<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Verdict.Desktop.ViewModels"
        xmlns:local="using:Verdict.Desktop.Views"
        x:Class="Verdict.Desktop.Views.StopkyWindow"
        x:DataType="vm:StopkyViewModel"
        Title="Stopky"
        Width="1280" Height="760"
        MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Classes="verdict-window">

  <local:StopkyView DataContext="{Binding}" />

</Window>
