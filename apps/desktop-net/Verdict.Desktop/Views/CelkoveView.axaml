<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Verdict.Desktop.ViewModels"
             x:Class="Verdict.Desktop.Views.CelkoveView"
             x:DataType="vm:CelkoveViewModel">

    <DockPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="Celkové výsledky jsou zatím prázdné — zadej výsledky kvalifikace."
                   Margin="16,16,16,8"
                   FontSize="13"
                   Opacity="0.7"
                   IsVisible="{Binding JePrazdne}"/>

        <DataGrid ItemsSource="{Binding Radky}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Poř."     Binding="{Binding Poradi}"   Width="55"/>
                <DataGridTextColumn Header="St.č."    Binding="{Binding StCislo}"  Width="65"/>
                <DataGridTextColumn Header="Příjmení" Binding="{Binding Prijmeni}" Width="180"/>
                <DataGridTextColumn Header="Jméno"    Binding="{Binding Jmeno}"    Width="140"/>
                <DataGridTextColumn Header="Po Q3"    Binding="{Binding PqText}"   Width="75"/>
                <DataGridTextColumn Header="SF"       Binding="{Binding PsfText}"  Width="60"/>
                <DataGridTextColumn Header="Finále"   Binding="{Binding PfText}"   Width="70"/>
                <DataGridTextColumn Header="Body Q"   Binding="{Binding Bq}"       Width="75"/>
            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>

</UserControl>
