<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Verdict.Desktop.ViewModels"
             x:Class="Verdict.Desktop.Views.VysledkyView"
             x:DataType="vm:VysledkyViewModel">

    <DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Top"
                Padding="16,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderColor}"
                Background="{DynamicResource SurfaceColor}"
                IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource MutedColor}"/>
        </Border>

        <!-- Jizdy -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Jizdy}"
                          Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:JizdaVysledkyViewModel">
                        <StackPanel Margin="0,0,0,24">

                            <TextBlock Text="{Binding CisloLabel}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Margin="16,6,16,4"
                                       Foreground="{DynamicResource ForegroundColor}"/>

                            <!-- Paste-box -->
                            <Border Padding="16,4,16,10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{Binding PasteText}"
                                             PlaceholderText="Vložit časy ze schránky (jeden čas na řádek)…"
                                             AcceptsReturn="True"
                                             MinWidth="360"
                                             MaxHeight="76"
                                             FontSize="12"
                                             FontFamily="Cascadia Code,Consolas,monospace"/>
                                    <Button Content="Načíst"
                                            Command="{Binding NacistCasyCommand}"
                                            Classes="outline"
                                            VerticalAlignment="Top"/>
                                </StackPanel>
                            </Border>

                            <!-- Výsledky tabulka -->
                            <DataGrid ItemsSource="{Binding Radky}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      GridLinesVisibility="Horizontal"
                                      CanUserResizeColumns="True"
                                      CellEditEnded="OnVysledekCellEditEnded">

                                <DataGrid.Columns>

                                    <!-- Pořadí s medailovou tečkou -->
                                    <DataGridTemplateColumn Header="Poř." Width="60" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:VysledekRadekViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center" Margin="10,0">
                                                    <Panel Width="8" Height="8" VerticalAlignment="Center">
                                                        <Ellipse Fill="{DynamicResource MedalGoldBrush}"
                                                                 IsVisible="{Binding JeZlato}"/>
                                                        <Ellipse Fill="{DynamicResource MedalSilverBrush}"
                                                                 IsVisible="{Binding JeStribro}"/>
                                                        <Ellipse Fill="{DynamicResource MedalBronzeBrush}"
                                                                 IsVisible="{Binding JeBronz}"/>
                                                    </Panel>
                                                    <TextBlock Text="{Binding PoradiText}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="St.č."   Binding="{Binding StCislo}"  Width="60"  IsReadOnly="True"/>

                                    <!-- Příjmení bold, read-only -->
                                    <DataGridTemplateColumn Header="Příjmení" Width="170" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:VysledekRadekViewModel">
                                                <TextBlock Text="{Binding Prijmeni}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="12,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Jméno"   Binding="{Binding Jmeno}"    Width="130" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Čas"     Binding="{Binding CasText}"  Width="105"/>

                                    <!-- Stav — prázdné pro OK -->
                                    <DataGridTemplateColumn Header="Stav" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:VysledekRadekViewModel">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="8,0">
                                                    <Border Classes="verdict-badge verdict-badge-dnf"
                                                            IsVisible="{Binding JeDnf}">
                                                        <TextBlock Text="DNF"/>
                                                    </Border>
                                                    <Border Classes="verdict-badge verdict-badge-dns"
                                                            IsVisible="{Binding JeDns}">
                                                        <TextBlock Text="DNS"/>
                                                    </Border>
                                                    <Border Classes="verdict-badge verdict-badge-dq"
                                                            IsVisible="{Binding JeDq}">
                                                        <TextBlock Text="DQ"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate x:DataType="vm:VysledekRadekViewModel">
                                                <TextBox Text="{Binding StavText}"
                                                         PlaceholderText="OK / DNF / DNS / DQ"
                                                         VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Pen."   Binding="{Binding PenalizaceText}" Width="80"  IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Body"   Binding="{Binding Body}"           Width="64"  IsReadOnly="True"/>

                                    <!-- Ředitelské úpravy -->
                                    <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:VysledekRadekViewModel">
                                                <Button Content="⚙"
                                                        Tag="{Binding}"
                                                        Click="OnUpravitClick"
                                                        FontSize="13"
                                                        Padding="4,2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Classes="ghost"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
